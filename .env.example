# Copy this file to .env and replace placeholder values before deploying.

EC2_API_URL=http://YOUR_PUBLIC_IP:8000

WORKER_TOKEN=change-me
WORKER_ID=my-laptop

ZIPVOICE_DEMO_MODE=hybrid
ZIPVOICE_WORKER_TOKEN=change-me

ZIPVOICE_S3_BUCKET=your-bucket
ZIPVOICE_S3_REGION=us-east-1
ZIPVOICE_S3_ENDPOINT_URL=
ZIPVOICE_AWS_PROFILE=

ZIPVOICE_S3_CHECKPOINT_KEY=zipvoice-ca/models/zipvoice_ca.pt
ZIPVOICE_S3_MODEL_CONFIG_KEY=zipvoice-ca/models/model.json
ZIPVOICE_S3_TOKENS_KEY=zipvoice-ca/models/tokens.txt

ZIPVOICE_S3_SAMPLES_PREFIX=zipvoice-ca/examples
ZIPVOICE_S3_RESULTS_PREFIX=zipvoice-ca/results
ZIPVOICE_S3_SAMPLES_MANIFEST_KEY=zipvoice-ca/manifests/samples_manifest.json
ZIPVOICE_S3_CACHED_RESULTS_MANIFEST_KEY=zipvoice-ca/manifests/cached_results_manifest.json

ZIPVOICE_S3_SAMPLE_TEXTS_KEY=
ZIPVOICE_S3_EXAMPLES_PREFIX=

ZIPVOICE_JOB_POLL_INTERVAL_SECONDS=5
ZIPVOICE_JOB_RESULT_URL_TTL=3600
ZIPVOICE_S3_EXAMPLE_URL_TTL=3600
ZIPVOICE_FRONTEND_DIST_DIR=deployment/frontend/dist
ZIPVOICE_MODEL_DIR=models/zipvoice_ca_runtime
ZIPVOICE_WORKER_LOG_LEVEL=INFO

ZIPVOICE_MAX_TEXT_CHARS=300
ZIPVOICE_MAX_PROMPT_TEXT_CHARS=300
ZIPVOICE_MAX_PROMPT_AUDIO_BYTES=10485760
ZIPVOICE_MAX_PROMPT_AUDIO_SECONDS=30
